{% layout 'password' %}

<div class="gift-card-page container" style="padding: 4rem 0; text-align: center;">
  <h1>Here's your gift card!</h1>
  <div style="font-size: 2rem; font-weight: bold; margin: 1.5rem 0;">
    {{ gift_card.initial_value | money_with_currency }}
  </div>
  <p>Use this code at checkout:</p>
  <code style="display: inline-block; padding: 0.75rem 1.5rem; background: #eee; font-size: 1.25rem; letter-spacing: 0.1em; border-radius: var(--border-radius); margin-bottom: 2rem;">
    {{ gift_card.code }}
  </code>
  <div>
    <a href="{{ shop.url }}" class="btn btn-primary">Start shopping</a>
  </div>
</div>
