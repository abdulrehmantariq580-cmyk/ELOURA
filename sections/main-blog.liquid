<div class="blog-page container" style="padding: 3rem 0;">
  <h1 style="text-align: center; margin-bottom: 3rem;">{{ blog.title }}</h1>

  {%- paginate blog.articles by 12 -%}
    <div class="grid grid-cols-3">
      {%- for article in blog.articles -%}
        <div class="article-card">
          {%- if article.image -%}
            <a href="{{ article.url }}">
              <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title }}" style="border-radius: var(--border-radius); width: 100%; aspect-ratio: 16/9; object-fit: cover;">
            </a>
          {%- endif -%}
          <div style="margin-top: 1rem;">
            <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <p style="color: var(--color-text-muted); font-size: 0.875rem;">{{ article.published_at | date: '%B %d, %Y' }}</p>
            <p>{{ article.excerpt_or_content | strip_html | truncatewords: 25 }}</p>
            <a href="{{ article.url }}" class="btn btn-secondary" style="margin-top: 0.5rem;">Read more</a>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      {% render 'pagination', paginate: paginate %}
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog Posts",
  "settings": []
}
{% endschema %}

