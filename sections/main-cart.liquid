{%- comment -%}
  ELOURA - High-End Editorial Cart Page (Represent Clo Minimalist Luxury Aesthetic)
{%- endcomment -%}

<div class="eloura-cart-page container">
  <!-- Header with Live Item Count & Subtitle -->
  <div class="eloura-cart__header">
    <div class="eloura-cart__header-title-wrap">
      <h1 class="eloura-cart__title">SHOPPING BAG</h1>
      <span class="eloura-cart__count">({{ cart.item_count }} {% if cart.item_count == 1 %}ITEM{% else %}ITEMS{% endif %})</span>
    </div>
    <a href="{{ routes.all_products_collection_url }}" class="eloura-cart__continue-shopping-top">
      &larr; CONTINUE SHOPPING
    </a>
  </div>

  {%- if cart.item_count > 0 -%}
    <!-- Free Delivery Interactive Progress Bar (Rs. 10,000 threshold) -->
    {%- assign free_shipping_threshold = 1000000 -%}
    {%- assign remaining = free_shipping_threshold | minus: cart.total_price -%}
    {%- assign progress_pct = cart.total_price | times: 100 | divided_by: free_shipping_threshold -%}
    {%- if progress_pct > 100 -%}{%- assign progress_pct = 100 -%}{%- endif -%}

    <div class="eloura-cart__shipping-banner">
      <div class="eloura-cart__shipping-text">
        {%- if remaining > 0 -%}
          ADD <strong>{{ remaining | money }}</strong> MORE TO UNLOCK <strong>FREE STANDARD DELIVERY</strong>
        {%- else -%}
          <strong>CONGRATULATIONS! YOU UNLOCKED FREE DELIVERY</strong> ⚡
        {%- endif -%}
      </div>
      <div class="eloura-cart__progress-track">
        <div class="eloura-cart__progress-fill" style="width: {{ progress_pct }}%;"></div>
      </div>
    </div>

    <form action="{{ routes.cart_url }}" method="post" id="CartForm" class="eloura-cart__layout">
      <!-- Left Column: Bag Items -->
      <div class="eloura-cart__items-col">
        <div class="eloura-cart__table-header">
          <span>PRODUCT</span>
          <span>PRICE</span>
          <span>QUANTITY</span>
          <span>SUBTOTAL</span>
        </div>

        <div class="eloura-cart__items-list">
          {%- for item in cart.items -%}
            <div class="eloura-cart__row" data-line="{{ forloop.index }}">
              <!-- Image with subtle luxury border -->
              <div class="eloura-cart__media">
                <a href="{{ item.url }}">
                  {%- if item.image -%}
                    <img
                      src="{{ item.image | image_url: width: 360 }}"
                      alt="{{ item.title | escape }}"
                      class="eloura-cart__img"
                      loading="lazy"
                      width="140"
                      height="175"
                    >
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'eloura-cart__img' }}
                  {%- endif -%}
                </a>
              </div>

              <!-- Product Info -->
              <div class="eloura-cart__info">
                <h3 class="eloura-cart__item-title">
                  <a href="{{ item.url }}">{{ item.product.title }}</a>
                </h3>

                {%- unless item.product.has_only_default_variant -%}
                  <p class="eloura-cart__item-variant">{{ item.variant.title }}</p>
                {%- endunless -%}

                <div class="eloura-cart__mobile-meta">
                  <span class="eloura-cart__unit-price">{{ item.original_price | money }}</span>
                </div>

                <a
                  href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0"
                  class="eloura-cart__remove-link"
                  aria-label="Remove {{ item.title | escape }}"
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                  <span>Remove</span>
                </a>
              </div>

              <!-- Desktop Unit Price Cell -->
              <div class="eloura-cart__price-cell">
                {{ item.original_price | money }}
              </div>

              <!-- Quantity Stepper -->
              <div class="eloura-cart__qty-cell">
                <div class="eloura-cart__stepper">
                  <a
                    href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}"
                    class="eloura-cart__stepper-btn"
                    aria-label="Decrease quantity"
                  >&minus;</a>
                  <span class="eloura-cart__stepper-val">{{ item.quantity }}</span>
                  <a
                    href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}"
                    class="eloura-cart__stepper-btn"
                    aria-label="Increase quantity"
                  >&plus;</a>
                </div>
              </div>

              <!-- Line Total Cell -->
              <div class="eloura-cart__total-cell">
                <strong>{{ item.final_line_price | money }}</strong>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <!-- Cart Page Assurance Notes (Transit Guarantee, Easy Returns) -->
        <div class="eloura-cart__badges-strip">
          <div class="eloura-cart__badge-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
            <div>
              <strong>FAST NATIONWIDE SHIPPING</strong>
              <p>Safe delivery right to your doorstep</p>
            </div>
          </div>
          <div class="eloura-cart__badge-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            <div>
              <strong>TRANSIT GUARANTEE</strong>
              <p>Replacement if damaged in transit</p>
            </div>
          </div>
          <div class="eloura-cart__badge-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            <div>
              <strong>SECURE PAYMENTS</strong>
              <p>Verified Bank Transfer &amp; Easypaisa</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Luxury Order Summary Card -->
      <div class="eloura-cart__summary-col">
        <div class="eloura-cart__summary-card">
          <h2 class="eloura-cart__summary-title">ORDER SUMMARY</h2>

          {%- assign shipping_charge = 30000 -%}
          {%- if cart.total_price >= free_shipping_threshold -%}
            {%- assign shipping_charge = 0 -%}
          {%- endif -%}
          {%- assign final_total = cart.total_price | plus: shipping_charge -%}

          <div class="eloura-cart__summary-row">
            <span class="eloura-cart__summary-label">Subtotal</span>
            <span class="eloura-cart__summary-price">{{ cart.total_price | money }}</span>
          </div>

          <div class="eloura-cart__summary-row">
            <span class="eloura-cart__summary-label">Estimated Delivery</span>
            <span>
              {%- if cart.total_price >= free_shipping_threshold -%}
                <span class="eloura-cart__shipping-strikethrough">Rs. 300.00</span>
                <strong class="eloura-cart__shipping-free">FREE DELIVERY</strong>
              {%- else -%}
                <strong>Rs. 300.00</strong>
              {%- endif -%}
            </span>
          </div>

          {%- if cart.total_price < free_shipping_threshold -%}
            <div class="eloura-cart__summary-tip">
              Add <strong>{{ free_shipping_threshold | minus: cart.total_price | money }}</strong> more for Free Delivery
            </div>
          {%- endif -%}

          <div class="eloura-cart__summary-total">
            <div>
              <span class="eloura-cart__total-label">TOTAL</span>
              <p class="eloura-cart__total-note">Including shipping charges</p>
            </div>
            <span class="eloura-cart__total-price">{{ final_total | money }}</span>
          </div>

          <button type="submit" name="checkout" class="eloura-cart__checkout-btn">
            PROCEED TO CHECKOUT &bull; {{ final_total | money }}
          </button>

          <a href="{{ routes.all_products_collection_url }}" class="eloura-cart__continue-btn">
            &larr; CONTINUE SHOPPING
          </a>

          <!-- Payment Security Icons -->
          <div class="eloura-cart__security">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            <span>Guaranteed 256-Bit Encrypted Checkout</span>
          </div>
        </div>
      </div>
    </form>
  {%- else -%}
    <!-- Luxury Empty Cart State -->
    <div class="eloura-cart__empty-state text-center">
      <div class="eloura-cart__empty-icon">
        <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.1">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
      </div>
      <h2 class="eloura-cart__empty-headline">YOUR SHOPPING BAG IS CURRENTLY EMPTY</h2>
      <p class="eloura-cart__empty-sub">Discover our latest drop, architectural streetwear, and heavyweight essentials.</p>
      <a href="{{ routes.all_products_collection_url }}" class="eloura-cart__shop-now-btn">
        EXPLORE NEW ARRIVALS
      </a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Luxury Cart Page",
  "settings": []
}
{% endschema %}
