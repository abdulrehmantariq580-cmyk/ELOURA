<div class="cart-page container">
  <h1>{{ 'sections.cart.title' | t }}</h1>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" id="cart">
      <table class="cart-table">
        <thead>
          <tr>
            <th>{{ 'sections.cart.product' | t }}</th>
            <th>{{ 'sections.cart.quantity' | t }}</th>
            <th>{{ 'sections.cart.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for item in cart.items -%}
            <tr>
              <td>
                <div style="display: flex; gap: 1rem; align-items: center;">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title }}" width="60" style="border-radius: var(--border-radius);">
                  {%- endif -%}
                  <div>
                    <a href="{{ item.url }}" style="font-weight: 600;">{{ item.product.title }}</a>
                    {%- unless item.product.has_only_default_variant -%}
                      <div style="font-size: 0.875rem; color: var(--color-text-muted);">{{ item.variant.title }}</div>
                    {%- endunless -%}
                    <div>
                      <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" style="color: #ef4444; font-size: 0.875rem;">
                        {{ 'sections.cart.remove' | t }}
                      </a>
                    </div>
                  </div>
                </div>
              </td>
              <td>
                <input
                  type="number"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                  class="form-input"
                  style="max-width: 80px;"
                >
              </td>
              <td style="font-weight: 600;">
                {{ item.final_line_price | money }}
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>

      <div class="cart-summary">
        <div style="display: flex; justify-content: space-between; font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem;">
          <span>{{ 'sections.cart.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <button type="submit" name="checkout" class="btn btn-primary btn-full">
          {{ 'sections.cart.checkout' | t }}
        </button>
      </div>
    </form>
  {%- else -%}
    <div style="text-align: center; padding: 4rem 0;">
      <p style="font-size: 1.25rem; color: var(--color-text-muted); margin-bottom: 1.5rem;">
        {{ 'sections.cart.empty' | t }}
      </p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary">
        {{ 'general.continue_shopping' | t }}
      </a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}

