{%- liquid
  assign hero_height_class = 'hero-banner--' | append: section.settings.height
  assign content_align_class = 'hero-content--' | append: section.settings.content_alignment
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
-%}

<section
  class="hero-banner {{ hero_height_class }}"
  data-section-id="{{ section.id }}"
  style="--overlay-opacity: {{ overlay_opacity }};"
>
  <!-- Background Media (Video or Image) -->
  <div class="hero-banner__media">
    {%- if section.settings.video_url != blank -%}
      <video
        class="hero-banner__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
      >
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {%- elsif section.settings.image_desktop != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source
            media="(max-width: 767px)"
            srcset="{{ section.settings.image_mobile | image_url: width: 800 }}"
          >
        {%- endif -%}
        <img
          src="{{ section.settings.image_desktop | image_url: width: 2400 }}"
          alt="{{ section.settings.heading | escape }}"
          class="hero-banner__image"
          loading="eager"
          width="2400"
          height="1400"
        >
      </picture>
    {%- else -%}
      <!-- Default Luxury Streetwear Campaign Fallback -->
      <img
        src="{{ 'hero-campaign-default.jpg' | asset_url }}"
        alt="ELOURA Autumn Winter Campaign"
        class="hero-banner__image"
        loading="eager"
        width="2400"
        height="1400"
      >
    {%- endif -%}

    <!-- Dark Gradient Vignette Overlay for Text Legibility -->
    <div class="hero-banner__overlay"></div>
  </div>

  <!-- Hero Content (Represent Signature Bottom-Centered Layout) -->
  <div class="container hero-banner__container">
    <div class="hero-content {{ content_align_class }}">
      {%- if section.settings.subheading != blank -%}
        <p class="hero-content__subheading">
          {{ section.settings.subheading }}
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hero-content__heading">
          {{ section.settings.heading }}
        </h1>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="hero-content__description">
          {{ section.settings.description }}
        </p>
      {%- endif -%}

      <!-- Action Buttons -->
      <div class="hero-content__actions">
        {%- if section.settings.button_label != blank -%}
          <a
            href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
            class="hero-btn hero-btn--frosted"
          >
            {{ section.settings.button_label | upcase }}
          </a>
        {%- endif -%}

        {%- if section.settings.secondary_button_label != blank -%}
          <a
            href="{{ section.settings.secondary_button_link | default: '/pages/lookbook' }}"
            class="hero-btn hero-btn--outline"
          >
            {{ section.settings.secondary_button_label | upcase }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if section.settings.show_scroll_indicator -%}
    <div class="hero-scroll-indicator" aria-hidden="true">
      <span class="hero-scroll-line"></span>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Editorial Hero Banner",
  "settings": [
    {
      "type": "header",
      "content": "Media Settings"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Campaign Image",
      "info": "Recommended: 2400 x 1400px. High-resolution lookbook image."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Campaign Image (Optional)",
      "info": "Recommended: 900 x 1400px vertical portrait image."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Direct MP4 Video URL (Optional)",
      "info": "Overrides image with a silent, looping background video."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 30,
      "unit": "%",
      "label": "Dark Overlay Opacity"
    },
    {
      "type": "header",
      "content": "Content & Typography"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading / Drop Tag",
      "default": "Latest Release"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Headline",
      "default": "Initial FW26"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Optional Description"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary Button Label"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Layout & Sizing"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Section Height",
      "options": [
        { "value": "fullscreen", "label": "Full Screen (100vh)" },
        { "value": "large", "label": "Large (85vh)" },
        { "value": "medium", "label": "Medium (70vh)" }
      ],
      "default": "fullscreen"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "options": [
        { "value": "bottom-center", "label": "Bottom Center (Represent Style)" },
        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "center", "label": "Middle Center" }
      ],
      "default": "bottom-center"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show subtle animated scroll line",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Editorial Hero Banner",
      "settings": {
        "subheading": "Latest Release",
        "heading": "Initial FW26",
        "button_label": "SHOP NOW",
        "height": "fullscreen",
        "content_alignment": "bottom-center"
      }
    }
  ]
}
{% endschema %}
