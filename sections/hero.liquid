{%- liquid
  assign collection = collections[section.settings.collection]
  assign product_limit = section.settings.products_to_show | default: 8
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0

  assign hero_title = section.settings.heading
  if hero_title == blank and collection != blank
    assign hero_title = collection.title
  endif
  if hero_title == blank
    assign hero_title = 'NEWEST ARRIVALS'
  endif

  assign target_link = section.settings.button_link
  if section.settings.link_to_destination == 'all_products'
    assign target_link = routes.all_products_collection_url
  elsif section.settings.link_to_destination == 'collection' and collection != blank
    assign target_link = collection.url
  elsif target_link == blank
    if collection != blank
      assign target_link = collection.url
    else
      assign target_link = routes.all_products_collection_url
    endif
  endif

  assign hero_height_class = 'hero-banner--' | append: section.settings.height
  assign content_align_class = 'hero-content--' | append: section.settings.content_alignment
-%}

<section
  class="hero-collection-section"
  data-section-id="{{ section.id }}"
  style="--overlay-opacity: {{ overlay_opacity }};"
>
  <!-- ======================================================================
       1. HERO EDITORIAL CAMPAIGN BANNER (DUAL VIDEO / MEDIA CAROUSEL)
       ====================================================================== -->
  {%- assign has_video_2 = false -%}
  {%- if section.settings.video_url_2 != blank or section.settings.video_url_2_mobile != blank -%}
    {%- assign has_video_2 = true -%}
  {%- endif -%}

  <div class="hero-banner {{ hero_height_class }}{% if has_video_2 %} hero-banner--carousel{% endif %}" id="HeroBanner-{{ section.id }}">
    <!-- Slides Track for Videos -->
    <div class="hero-banner__slides-track" id="HeroSlidesTrack-{{ section.id }}">
      
      <!-- Slide 1 -->
      <div class="hero-banner__slide is-active" data-slide-index="0">
        <div class="hero-banner__media">
          {%- if section.settings.video_url != blank or section.settings.video_url_mobile != blank -%}
            <!-- Desktop Video -->
            {%- if section.settings.video_url != blank -%}
              <video
                class="hero-banner__video hero-banner__video--desktop{% if section.settings.video_url_mobile != blank %} hide-mobile{% endif %}"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
              >
                <source src="{{ section.settings.video_url }}" type="video/mp4">
              </video>
            {%- endif -%}

            <!-- Mobile Video -->
            {%- if section.settings.video_url_mobile != blank -%}
              <video
                class="hero-banner__video hero-banner__video--mobile hide-desktop"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
              >
                <source src="{{ section.settings.video_url_mobile }}" type="video/mp4">
              </video>
            {%- endif -%}
          {%- elsif section.settings.image_desktop != blank -%}
            <picture>
              {%- if section.settings.image_mobile != blank -%}
                <source
                  media="(max-width: 767px)"
                  srcset="{{ section.settings.image_mobile | image_url: width: 900 }}"
                >
              {%- endif -%}
              <img
                src="{{ section.settings.image_desktop | image_url: width: 2400 }}"
                alt="{{ hero_title | escape }}"
                class="hero-banner__image"
                loading="eager"
                width="2400"
                height="1400"
              >
            </picture>
          {%- elsif collection.image != blank -%}
            <img
              src="{{ collection.image | image_url: width: 2400 }}"
              alt="{{ hero_title | escape }}"
              class="hero-banner__image"
              loading="eager"
              width="2400"
              height="1400"
            >
          {%- else -%}
            <img
              src="{{ 'hero-campaign-default.jpg' | asset_url }}"
              alt="ELOURA Campaign"
              class="hero-banner__image"
              loading="eager"
              width="2400"
              height="1400"
            >
          {%- endif -%}

          <!-- Dark Gradient Vignette Overlay -->
          <div class="hero-banner__overlay"></div>
        </div>
      </div>

      <!-- Slide 2 (Optional Second Video / Media) -->
      {%- if has_video_2 -%}
        <div class="hero-banner__slide" data-slide-index="1">
          <div class="hero-banner__media">
            <!-- Desktop Video 2 -->
            {%- if section.settings.video_url_2 != blank -%}
              <video
                class="hero-banner__video hero-banner__video--desktop{% if section.settings.video_url_2_mobile != blank %} hide-mobile{% endif %}"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
              >
                <source src="{{ section.settings.video_url_2 }}" type="video/mp4">
              </video>
            {%- endif -%}

            <!-- Mobile Video 2 -->
            {%- if section.settings.video_url_2_mobile != blank -%}
              <video
                class="hero-banner__video hero-banner__video--mobile hide-desktop"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
              >
                <source src="{{ section.settings.video_url_2_mobile }}" type="video/mp4">
              </video>
            {%- endif -%}

            <!-- Dark Gradient Vignette Overlay -->
            <div class="hero-banner__overlay"></div>
          </div>
        </div>
      {%- endif -%}

    </div>

    <!-- Hero Content: "Introducing" -> Collection Name -> SHOP NOW -->
    <div class="container hero-banner__container">
      <div class="hero-content {{ content_align_class }}">
        {%- if section.settings.subheading != blank -%}
          <p class="hero-content__subheading">
            {{ section.settings.subheading }}
          </p>
        {%- endif -%}

        <h1 class="hero-content__heading">
          {{ hero_title }}
        </h1>

        {%- if section.settings.description != blank -%}
          <p class="hero-content__description">
            {{ section.settings.description }}
          </p>
        {%- endif -%}

        <!-- Action Buttons -->
        <div class="hero-content__actions">
          {%- if section.settings.button_label != blank -%}
            <a
              href="{{ target_link }}"
              class="hero-btn hero-btn--frosted"
            >
              {{ section.settings.button_label | upcase }}
            </a>
          {%- endif -%}

          {%- if section.settings.secondary_button_label != blank -%}
            <a
              href="{{ section.settings.secondary_button_link | default: '/pages/lookbook' }}"
              class="hero-btn hero-btn--outline"
            >
              {{ section.settings.secondary_button_label | upcase }}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>

    <!-- Navigation Dots for Dual Video Carousel -->
    {%- if has_video_2 -%}
      <div class="hero-dots" id="HeroDots-{{ section.id }}" aria-label="Video slider controls">
        <button type="button" class="hero-dot is-active" data-index="0" aria-label="Slide 1"></button>
        <button type="button" class="hero-dot" data-index="1" aria-label="Slide 2"></button>
      </div>
    {%- endif -%}

    {%- if section.settings.show_scroll_indicator -%}
      <div class="hero-scroll-indicator" aria-hidden="true">
        <span class="hero-scroll-line"></span>
      </div>
    {%- endif -%}
  </div>

  {%- if has_video_2 -%}
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const track = document.getElementById('HeroSlidesTrack-{{ section.id }}');
        const dotsWrap = document.getElementById('HeroDots-{{ section.id }}');
        if (!track || !dotsWrap) return;

        const dots = dotsWrap.querySelectorAll('.hero-dot');
        const slides = track.querySelectorAll('.hero-banner__slide');
        let currentIndex = 0;

        function goToSlide(index) {
          currentIndex = index;
          track.style.transform = 'translateX(-' + (index * 100) + '%)';
          dots.forEach((d, i) => d.classList.toggle('is-active', i === index));
          slides.forEach((s, i) => s.classList.toggle('is-active', i === index));
        }

        dots.forEach((dot) => {
          dot.addEventListener('click', function() {
            const idx = parseInt(this.getAttribute('data-index'), 10);
            goToSlide(idx);
          });
        });

        // Touch swipe support for mobile
        let startX = 0;
        let diffX = 0;
        track.addEventListener('touchstart', function(e) {
          startX = e.touches[0].clientX;
          diffX = 0;
        }, { passive: true });

        track.addEventListener('touchmove', function(e) {
          diffX = e.touches[0].clientX - startX;
        }, { passive: true });

        track.addEventListener('touchend', function() {
          if (Math.abs(diffX) > 40) {
            if (diffX < 0 && currentIndex === 0) {
              goToSlide(1);
            } else if (diffX > 0 && currentIndex === 1) {
              goToSlide(0);
            }
          }
        });
      });
    </script>
  {%- endif -%}

  <!-- ======================================================================
       2. SLIDING PRODUCT CATALOG FOR THIS HERO COLLECTION
       ====================================================================== -->
  {%- if section.settings.show_products -%}
    <div class="sliding-products__wrapper">
      {%- if collection == blank -%}
        <div class="container hero-newest-arrivals__header">
          <span class="hero-newest-arrivals__eyebrow">JUST DROPPED</span>
          <h2 class="hero-newest-arrivals__title">
            NEWEST ARRIVALS
          </h2>
          <div class="hero-newest-arrivals__divider"></div>
        </div>
      {%- endif -%}

      <div class="sliding-products__track-container js-product-slider">
        <div class="sliding-products__track">
          {%- if collection != blank and collection.products.size > 0 -%}
            {%- for product in collection.products limit: product_limit -%}
              <div class="sliding-products__item">
                {% render 'product-card', product: product %}
              </div>
            {%- endfor -%}
          {%- elsif section.settings.use_all_products -%}
            {%- assign sorted_products = collections.all.products | sort: 'created_at' | reverse -%}
            {%- for product in sorted_products limit: product_limit -%}
              <div class="sliding-products__item">
                {% render 'product-card', product: product %}
              </div>
            {%- endfor -%}
          {%- else -%}
            <!-- Clean Default Fallback Streetwear Items matching Reference -->
            {%- for i in (1..6) -%}
              <div class="sliding-products__item">
                <div class="product-card">
                  <div class="product-card__media-box">
                    <button type="button" class="product-card__bookmark-btn" aria-label="Save to Wishlist">
                      {% render 'icon-bookmark' %}
                    </button>
                    <div class="product-card__link">
                      {{ 'product-' | append: i | placeholder_svg_tag: 'product-card__img product-card__img--placeholder' }}
                    </div>
                    <button type="button" class="product-card__quick-add-btn" aria-label="Quick Add">
                      {% render 'icon-plus' %}
                    </button>
                  </div>
                  <div class="product-card__meta">
                    <h3 class="product-card__name">
                      <a href="#">
                        {%- case i -%}
                          {%- when 1 -%}Initial Quarter Zip Jacket
                          {%- when 2 -%}Initial Knitted Coach Jacket
                          {%- when 3 -%}Ribbed Knitted Track Jacket
                          {%- when 4 -%}Heavyweight Loopback Hoodie
                          {%- when 5 -%}Relaxed Tailored Cargo Pant
                          {%- else -%}Artisan Relaxed Tracksuit
                        {%- endcase -%}
                      </a>
                    </h3>
                    
                    <div class="product-card__pricing">
                      <span class="product-card__price">
                        {%- case i -%}
                          {%- when 1 -%}$165
                          {%- when 2 -%}$245
                          {%- when 3 -%}$245
                          {%- when 4 -%}$185
                          {%- else -%}$210
                        {%- endcase -%}
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      <!-- Bottom Directional CTA Link (Represent Style: → SHOP [COLLECTION] or → SHOP ALL PRODUCTS) -->
      <div class="sliding-products__footer">
        <a href="{{ target_link }}" class="sliding-products__cta-link">
          <span class="sliding-products__arrow">&rarr;</span>
          <span class="sliding-products__link-text">
            {%- if section.settings.bottom_link_text != blank -%}
              {{ section.settings.bottom_link_text | upcase }}
            {%- elsif collection == blank -%}
              SHOP ALL PRODUCTS
            {%- else -%}
              SHOP {{ hero_title | upcase }}
            {%- endif -%}
          </span>
        </a>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero Collection Section",
  "settings": [
    {
      "type": "header",
      "content": "Collection Assignment"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection",
      "info": "Choose a specific collection (e.g. Outerwear, Hoodies). Its products will automatically show in the sliding catalog below."
    },
    {
      "type": "checkbox",
      "id": "use_all_products",
      "label": "Show All Store Products if no collection is selected",
      "default": true
    },
    {
      "type": "header",
      "content": "Banner Media - Video 1 (First Slide)"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video 1 - Desktop MP4 URL",
      "info": "Overrides image with a silent, looping background video on desktop/laptop screens."
    },
    {
      "type": "text",
      "id": "video_url_mobile",
      "label": "Video 1 - Mobile MP4 URL",
      "info": "Vertical portrait video for phone screens."
    },
    {
      "type": "header",
      "content": "Banner Media - Video 2 (Second Slide)"
    },
    {
      "type": "text",
      "id": "video_url_2",
      "label": "Video 2 - Desktop MP4 URL",
      "info": "Second video for Desktop screens."
    },
    {
      "type": "text",
      "id": "video_url_2_mobile",
      "label": "Video 2 - Mobile MP4 URL",
      "info": "Second video for Mobile screens. When Video 2 is added, 2 navigation dots appear and user can swipe/click to switch videos."
    },
    {
      "type": "header",
      "content": "Fallback Images (If No Video)"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Campaign Image",
      "info": "If empty, the selected collection's image or default campaign lookbook image will be used."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Campaign Image (Optional)",
      "info": "Vertical portrait image for mobile screens."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 30,
      "unit": "%",
      "label": "Dark Vignette Overlay Opacity"
    },
    {
      "type": "header",
      "content": "Banner Content & Typography"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Top Label / Subheading",
      "default": "Introducing"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Headline / Collection Name",
      "info": "Leave blank to automatically use the selected Collection's title."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Optional Description"
    },
    {
      "type": "header",
      "content": "Buttons & Destination Link"
    },
    {
      "type": "select",
      "id": "link_to_destination",
      "label": "Button Link Target",
      "options": [
        {
          "value": "collection",
          "label": "Selected Collection (/collections/your-collection)"
        },
        {
          "value": "all_products",
          "label": "All Products (/collections/all)"
        },
        {
          "value": "custom",
          "label": "Custom URL (Use link field below)"
        }
      ],
      "default": "collection",
      "info": "Choose whether clicking 'SHOP NOW' opens only this collection's products or all store products."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Custom URL (Only used if Target is set to Custom)",
      "info": "Optional custom link."
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary Button Label"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Banner Sizing & Alignment"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Banner Height",
      "options": [
        { "value": "fullscreen", "label": "Full Screen (100vh)" },
        { "value": "large", "label": "Large (85vh)" },
        { "value": "medium", "label": "Medium (70vh)" }
      ],
      "default": "fullscreen"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "options": [
        { "value": "bottom-center", "label": "Bottom Center (Represent Style)" },
        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "center", "label": "Middle Center" }
      ],
      "default": "bottom-center"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show subtle animated scroll line",
      "default": false
    },
    {
      "type": "header",
      "content": "Sliding Product Catalog"
    },
    {
      "type": "checkbox",
      "id": "show_products",
      "label": "Show Sliding Products Below Banner",
      "default": true
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 20,
      "step": 2,
      "default": 8,
      "label": "Number of products to show"
    },
    {
      "type": "text",
      "id": "bottom_link_text",
      "label": "Bottom Arrow Link Text",
      "info": "Leave blank to automatically display 'SHOP [COLLECTION NAME]'."
    }
  ],
  "presets": [
    {
      "name": "Hero Collection Section",
      "settings": {
        "subheading": "Introducing",
        "button_label": "SHOP NOW",
        "height": "fullscreen",
        "content_alignment": "bottom-center",
        "show_products": true
      }
    }
  ]
}
{% endschema %}
