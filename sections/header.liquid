<header class="site-header">
  <div class="container site-header__wrapper">
    <div class="site-header__logo">
      <a href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 300 | image_tag: alt: shop.name }}
        {%- else -%}
          <span>{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    <nav class="site-nav" role="navigation" aria-label="Main Navigation">
      <ul class="site-nav__list">
        {%- for link in linklists[section.settings.menu].links -%}
          <li class="site-nav__item">
            <a href="{{ link.url }}" class="site-nav__link{% if link.current %} site-nav__link--active{% endif %}">
              {{ link.title }}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href="{{ routes.search_url }}" class="site-header__icon" aria-label="{{ 'general.search' | t }}">
        {% render 'icon-search' %}
      </a>

      {%- if section.settings.show_cart -%}
        <a href="{{ routes.cart_url }}" class="site-header__icon site-header__cart" aria-label="{{ 'header.cart' | t }}">
          {% render 'icon-cart' %}
          <span class="cart-count">{{ cart.item_count }}</span>
        </a>
      {%- endif -%}

      <button type="button" class="mobile-menu-toggle" aria-expanded="false" aria-label="{{ 'header.menu' | t }}">
        {% render 'icon-menu' %}
      </button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart icon",
      "default": true
    }
  ]
}
{% endschema %}
