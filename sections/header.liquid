{%- liquid
  assign sticky_class = ''
  if section.settings.sticky_header
    assign sticky_class = ' site-header--sticky'
  endif
  assign overlay_class = ''
  if template.name == 'index' or section.settings.transparent_header
    unless template.name == 'product'
      assign overlay_class = ' site-header--overlay'
    endunless
  endif
-%}

<header
  class="site-header{{ sticky_class }}{{ overlay_class }}"
  data-section-id="{{ section.id }}"
  data-sticky="{{ section.settings.sticky_header }}"
>
  <div class="site-header__inner container-fluid">
    <!-- Left Action Group: Menu Drawer, Search, Notifications -->
    <div class="site-header__group site-header__group--left">
      <button
        type="button"
        class="header-icon-btn js-drawer-open"
        aria-label="Open Navigation Menu"
        aria-controls="NavDrawer"
        aria-expanded="false"
      >
        {% render 'icon-menu' %}
        <span class="sr-only">Menu</span>
      </button>

      <button
        type="button"
        class="header-icon-btn js-search-open"
        aria-label="Open Search"
        aria-controls="SearchDrawer"
        aria-expanded="false"
      >
        {% render 'icon-search' %}
        <span class="sr-only">Search</span>
      </button>
    </div>

    <!-- Center: Brand Logo / Wordmark -->
    <div class="site-header__logo-container">
      <a href="{{ routes.root_url }}" class="site-header__logo-link">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: 400 }}"
            alt="{{ shop.name }}"
            class="site-header__logo-image"
            width="{{ section.settings.logo_width }}"
            height="auto"
            loading="eager"
          >
        {%- else -%}
          <!-- ELOURA Minimalist Luxury Wordmark Matching Brand Identity -->
          <div class="eloura-brandmark">
            <span class="eloura-brandmark__text">E L <span class="eloura-brandmark__underline">O U</span> R A</span>
          </div>
        {%- endif -%}
      </a>
    </div>

    <!-- Right Action Group: Account, Cart Bag -->
    <div class="site-header__group site-header__group--right">
      {%- if shop.customer_accounts_enabled and section.settings.show_account -%}
        <a
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          class="header-icon-btn header-account-btn"
          aria-label="Account"
        >
          {% render 'icon-account' %}
          <span class="sr-only">Account</span>
        </a>
      {%- endif -%}

      {%- if section.settings.show_cart -%}
        <a
          href="{{ routes.cart_url }}"
          class="header-icon-btn header-cart-btn js-cart-drawer-trigger"
          aria-label="Shopping Bag"
        >
          {% render 'icon-cart' %}
          <span class="cart-bubble{% if cart.item_count == 0 %} is-empty{% endif %}" id="CartBubble" data-cart-count="{{ cart.item_count }}">
            {{ cart.item_count }}
          </span>
          <span class="sr-only">Shopping Bag</span>
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.enable_desktop_nav and linklists[section.settings.menu].links.size > 0 -%}
    <nav class="site-header__desktop-nav container" role="navigation" aria-label="Desktop Navigation">
      <ul class="desktop-nav__list">
        {%- for link in linklists[section.settings.menu].links -%}
          <li class="desktop-nav__item">
            <a
              href="{{ link.url }}"
              class="desktop-nav__link{% if link.current %} desktop-nav__link--active{% endif %}"
            >
              {{ link.title | upcase }}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}
</header>

<!-- ==========================================================================
     REPRESENT-STYLE SLIDE-OVER NAVIGATION DRAWER (Clean Solid White Design)
     ========================================================================== -->
<div id="NavDrawer" class="nav-drawer" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="nav-drawer__overlay js-drawer-close"></div>

  <div class="nav-drawer__panel">
    <!-- 1. Drawer Top Header: Logo Text & Close Button -->
    <div class="nav-drawer__header">
      <a href="{{ routes.root_url }}" class="nav-drawer__brand-link js-drawer-close">
        <span class="eloura-brandmark__text" style="font-size: 1.15rem; letter-spacing: 0.24em; color: #0A0A0A; font-weight: 700;">
          E L <span class="eloura-brandmark__underline">O U</span> R A
        </span>
      </a>
      <button type="button" class="nav-drawer__close js-drawer-close" aria-label="Close Navigation">
        {% render 'icon-close' %}
      </button>
    </div>

    <!-- 2. Search Bar: Direct action to /collections/all with search autofocus -->
    <div class="nav-drawer__search">
      <form action="{{ routes.all_products_collection_url }}" method="get" role="search" class="drawer-search-form">
        <input
          type="search"
          name="q"
          placeholder="SEARCH ALL PRODUCTS..."
          class="drawer-search-input"
          autocomplete="off"
        >
        <button type="submit" class="drawer-search-btn" aria-label="Search Catalog">
          {% render 'icon-search' %}
        </button>
      </form>
    </div>

    <!-- 3. Drawer Navigation Links -->
    <div class="nav-drawer__body">
      <ul class="drawer-nav__list">
        <!-- HOME Link -->
        <li class="drawer-nav__item">
          <a href="{{ routes.root_url }}" class="drawer-nav__link">
            HOME
          </a>
        </li>

        <!-- All Collections dynamically listed -->
        {%- for col in collections -%}
          {%- unless col.handle == 'all' or col.handle == 'frontpage' -%}
            <li class="drawer-nav__item">
              <a href="{{ col.url }}" class="drawer-nav__link">
                {{ col.title | upcase }}
              </a>
            </li>
          {%- endunless -%}
        {%- endfor -%}

        <!-- ALL PRODUCTS Link -->
        <li class="drawer-nav__item drawer-nav__item--highlight">
          <a href="{{ routes.all_products_collection_url }}" class="drawer-nav__link">
            ALL PRODUCTS
          </a>
        </li>

        <!-- CONTACT Link -->
        <li class="drawer-nav__item">
          <a href="/pages/contact" class="drawer-nav__link">
            CONTACT
          </a>
        </li>
      </ul>
    </div>

    <!-- 4. Drawer Footer: Clean Minimalist Social Media Icons (Instagram, Facebook, TikTok, WhatsApp) -->
    <div class="nav-drawer__footer">
      <div class="drawer-social-icons">
        <!-- Instagram -->
        <a href="https://instagram.com/eloura.pk1" target="_blank" rel="noopener" class="drawer-social-icon" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>

        <!-- Facebook -->
        <a href="https://facebook.com" target="_blank" rel="noopener" class="drawer-social-icon" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
          </svg>
        </a>

        <!-- TikTok -->
        <a href="https://tiktok.com" target="_blank" rel="noopener" class="drawer-social-icon" aria-label="TikTok">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
          </svg>
        </a>

        <!-- WhatsApp -->
        <a href="https://wa.me/923000000000" target="_blank" rel="noopener" class="drawer-social-icon" aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

<!-- ==========================================================================
     SLIDE-DOWN QUICK SEARCH MODAL
     ========================================================================== -->
<div id="SearchDrawer" class="search-drawer" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="search-drawer__overlay js-search-close"></div>

  <div class="search-drawer__content">
    <div class="container search-drawer__container">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-bar-form">
        <input type="hidden" name="type" value="product">
        <div class="search-bar__input-wrapper">
          <input
            type="search"
            name="q"
            id="SearchInput"
            placeholder="TYPE TO SEARCH ELOURA CATALOG..."
            class="search-bar__input"
            autocomplete="off"
          >
          <button type="button" class="search-bar__close js-search-close" aria-label="Close Search">
            {% render 'icon-close' %}
          </button>
        </div>
      </form>

      <!-- Popular / Trending Search Pills -->
      <div class="search-suggestions">
        <span class="search-suggestions__label">POPULAR:</span>
        <a href="{{ routes.search_url }}?q=Jacket&type=product" class="search-tag">JACKETS</a>
        <a href="{{ routes.search_url }}?q=Hoodie&type=product" class="search-tag">HOODIES</a>
        <a href="{{ routes.search_url }}?q=Pants&type=product" class="search-tag">PANTS</a>
        <a href="{{ routes.search_url }}?q=Black&type=product" class="search-tag">JET BLACK</a>
        <a href="{{ routes.search_url }}?q=Green&type=product" class="search-tag">ARMY GREEN</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Logo Image",
      "info": "If left blank, the signature ELOURA luxury wordmark will display automatically."
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 100,
      "max": 250,
      "step": 10,
      "default": 140,
      "unit": "px",
      "label": "Logo Width"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "enable_desktop_nav",
      "label": "Show Horizontal Navigation on Desktop",
      "default": false,
      "info": "When disabled, the clean Represent icon-first layout is used."
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Enable Sticky Frosted Header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "transparent_header",
      "label": "Enable Translucent Overlay Mode",
      "default": true
    },
    {
      "type": "header",
      "content": "Action Icons"
    },
    {
      "type": "checkbox",
      "id": "show_notification_bell",
      "label": "Show Drop Notifications Bell",
      "default": true
    },
    {
      "type": "text",
      "id": "notification_count",
      "label": "Notification Badge Number",
      "default": "2"
    },
    {
      "type": "url",
      "id": "notification_link",
      "label": "Notification Link"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show Bookmark / Wishlist Icon",
      "default": true
    },
    {
      "type": "url",
      "id": "wishlist_link",
      "label": "Wishlist Page Link"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show Account Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show Bag / Cart Icon",
      "default": true
    }
  ]
}
{% endschema %}
