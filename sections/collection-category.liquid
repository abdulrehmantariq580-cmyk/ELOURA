{%- liquid
  assign collection = collections[section.settings.collection]
  assign product_limit = section.settings.products_to_show | default: 8
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0

  assign collection_title = section.settings.heading
  if collection_title == blank and collection != blank
    assign collection_title = collection.title
  endif
  if collection_title == blank
    assign collection_title = 'Initial FW26'
  endif

  assign target_link = section.settings.link
  if target_link == blank and collection != blank
    assign target_link = collection.url
  endif
  if target_link == blank
    assign target_link = routes.all_products_collection_url
  endif
-%}

<section class="collection-category-section" data-section-id="{{ section.id }}" style="--overlay-opacity: {{ overlay_opacity }};">
  <!-- 1. Editorial Campaign Banner for this Collection / Category -->
  <div class="category-banner category-banner--{{ section.settings.banner_height }}">
    <div class="category-banner__media">
      {%- if section.settings.image_desktop != blank -%}
        <picture>
          {%- if section.settings.image_mobile != blank -%}
            <source media="(max-width: 767px)" srcset="{{ section.settings.image_mobile | image_url: width: 900 }}">
          {%- endif -%}
          <img
            src="{{ section.settings.image_desktop | image_url: width: 2400 }}"
            alt="{{ collection_title | escape }}"
            class="category-banner__img"
            loading="lazy"
            width="2400"
            height="1300"
          >
        </picture>
      {%- elsif collection.image != blank -%}
        <img
          src="{{ collection.image | image_url: width: 2400 }}"
          alt="{{ collection_title | escape }}"
          class="category-banner__img"
          loading="lazy"
          width="2400"
          height="1300"
        >
      {%- else -%}
        <img
          src="{{ 'editorial-campaign-2.jpg' | asset_url }}"
          alt="ELOURA Collection Campaign"
          class="category-banner__img"
          loading="lazy"
          width="2400"
          height="1300"
        >
      {%- endif -%}

      <div class="category-banner__overlay"></div>
    </div>

    <!-- Banner Content: "INTRODUCING" -> Collection Name -> SHOP NOW -->
    <div class="category-banner__content container">
      <div class="category-banner__inner">
        {%- if section.settings.subheading != blank -%}
          <p class="category-banner__subheading">
            {{ section.settings.subheading }}
          </p>
        {%- endif -%}

        <h2 class="category-banner__heading">
          {{ collection_title }}
        </h2>

        {%- if section.settings.button_label != blank -%}
          <div class="category-banner__action">
            <a href="{{ target_link }}" class="hero-btn hero-btn--frosted">
              {{ section.settings.button_label | upcase }}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <!-- 2. Automatically Displayed Products Slider for this Collection -->
  <div class="sliding-products__wrapper">
    <div class="sliding-products__track-container js-product-slider">
      <div class="sliding-products__track">
        {%- if collection != blank and collection.products.size > 0 -%}
          {%- for product in collection.products limit: product_limit -%}
            <div class="sliding-products__item">
              {% render 'product-card', product: product %}
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Placeholder Demo Items when no collection is linked yet -->
          {%- for i in (1..6) -%}
            <div class="sliding-products__item">
              <div class="product-card">
                <div class="product-card__media-box">
                  <button type="button" class="product-card__bookmark-btn" aria-label="Save to Wishlist">
                    {% render 'icon-bookmark' %}
                  </button>
                  <div class="product-card__link">
                    {{ 'product-' | append: i | placeholder_svg_tag: 'product-card__img product-card__img--placeholder' }}
                  </div>
                  <button type="button" class="product-card__quick-add-btn" aria-label="Quick Add">
                    {% render 'icon-plus' %}
                  </button>
                </div>
                <div class="product-card__meta">
                  <h3 class="product-card__name">
                    <a href="#">
                      {%- case i -%}
                        {%- when 1 -%}Initial Quarter Zip Jacket
                        {%- when 2 -%}Initial Knitted Coach Jacket
                        {%- when 3 -%}Ribbed Knitted Track Jacket
                        {%- when 4 -%}Heavyweight Loopback Hoodie
                        {%- when 5 -%}Relaxed Tailored Cargo Pant
                        {%- else -%}Artisan Relaxed Tracksuit
                      {%- endcase -%}
                    </a>
                  </h3>
                  <p class="product-card__color-title">
                    {%- case i -%}
                      {%- when 3 -%}Vintage Black
                      {%- when 4 -%}Army Olive
                      {%- else -%}Jet Black
                    {%- endcase -%}
                  </p>
                  <div class="product-card__swatch-row">
                    <span class="product-card__swatch-dot" style="background-color: {% if i == 4 %}#3B443B{% elsif i == 3 %}#2B2B2B{% else %}#111111{% endif %};"></span>
                    <span class="product-card__colour-count">1 Colour</span>
                  </div>
                  <div class="product-card__pricing">
                    <span class="product-card__price">
                      {%- case i -%}
                        {%- when 1 -%}$165
                        {%- when 2 -%}$245
                        {%- when 3 -%}$245
                        {%- when 4 -%}$185
                        {%- else -%}$210
                      {%- endcase -%}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <!-- 3. Bottom Collection CTA Link -->
    <div class="sliding-products__footer">
      <a href="{{ target_link }}" class="sliding-products__cta-link">
        <span class="sliding-products__arrow">&rarr;</span>
        <span class="sliding-products__link-text">
          {%- if section.settings.link_text != blank -%}
            {{ section.settings.link_text | upcase }}
          {%- else -%}
            VIEW ALL {{ collection_title | upcase }}
          {%- endif -%}
        </span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Category Block",
  "settings": [
    {
      "type": "header",
      "content": "Collection Selection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection",
      "info": "All products in this collection will automatically appear in the sliding track below the banner."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 20,
      "step": 2,
      "default": 8,
      "label": "Number of products to show"
    },
    {
      "type": "header",
      "content": "Banner Media"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Campaign Banner Image",
      "info": "If left blank, the selected collection's image or campaign image will be used."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Campaign Banner Image (Optional)"
    },
    {
      "type": "select",
      "id": "banner_height",
      "label": "Banner Height",
      "options": [
        { "value": "large", "label": "Large (85vh)" },
        { "value": "medium", "label": "Medium (70vh)" },
        { "value": "small", "label": "Compact (55vh)" }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 30,
      "unit": "%",
      "label": "Banner Dark Vignette Overlay"
    },
    {
      "type": "header",
      "content": "Banner Content & Typography"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Top Label / Subheading",
      "default": "Introducing"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Collection Name / Custom Title",
      "info": "Leave blank to automatically use the selected Collection's title."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Custom Link URL",
      "info": "Leave blank to automatically link to the selected Collection."
    },
    {
      "type": "header",
      "content": "Bottom Link"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Bottom Arrow Link Text",
      "info": "Leave blank to automatically show 'VIEW ALL [COLLECTION NAME]'."
    }
  ],
  "presets": [
    {
      "name": "Collection Category Block",
      "settings": {
        "subheading": "Introducing",
        "button_label": "SHOP NOW",
        "banner_height": "large"
      }
    }
  ]
}
{% endschema %}
