{%- comment -%}
  ELOURA - Editorial Video / Image Campaign Banner
{%- endcomment -%}

<section class="pdp-banner-section" data-section-id="{{ section.id }}">
  <div class="pdp-banner-container {% if section.settings.full_width %}pdp-banner--full{% else %}container{% endif %}">
    <div class="pdp-banner-media">
      {%- if section.settings.video_url != blank -%}
        <video
          class="pdp-banner-video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
        >
          <source src="{{ section.settings.video_url }}" type="video/mp4">
        </video>
      {%- elsif section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 2400 }}"
          alt="{{ section.settings.heading | default: 'Campaign Banner' | escape }}"
          class="pdp-banner-image"
          loading="lazy"
          width="2400"
          height="1200"
        >
      {%- else -%}
        <div class="pdp-banner-placeholder">
          {{ 'lifestyle-2' | placeholder_svg_tag: 'pdp-banner-placeholder-svg' }}
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="pdp-banner-overlay">
          <div class="pdp-banner-content text-center">
            {%- if section.settings.subheading != blank -%}
              <p class="pdp-banner-subheading">{{ section.settings.subheading | upcase }}</p>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <h2 class="pdp-banner-heading">{{ section.settings.heading }}</h2>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PDP Campaign Media Banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Screen Width",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Direct MP4 Video Link (Overrides Image)"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "THE COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "ARCHITECTURAL FIT. TIMELESS QUALITY."
    }
  ],
  "presets": [
    {
      "name": "PDP Campaign Media Banner"
    }
  ]
}
{% endschema %}

