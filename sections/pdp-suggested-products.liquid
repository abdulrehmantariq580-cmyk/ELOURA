{%- comment -%}
  ELOURA - Suggested / Recommended Products Carousel
{%- endcomment -%}

<section class="pdp-recommendations-section" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="pdp-recommendations__header">
      <h3 class="pdp-recommendations__title">{{ section.settings.heading | default: 'COMPLETE THE LOOK' | upcase }}</h3>
    </div>

    <div class="sliding-products__track-container js-product-slider">
      <div class="sliding-products__track">
        {%- liquid
          assign count = 0
          assign current_id = product.id
          assign target_collection = collection
          if target_collection == blank or target_collection.products_count < 2
            assign target_collection = collections.all
          endif
        -%}

        {%- for prod in target_collection.products -%}
          {%- unless prod.id == current_id -%}
            <div class="sliding-products__item">
              {% render 'product-card', product: prod %}
            </div>
            {%- assign count = count | plus: 1 -%}
            {%- if count >= section.settings.products_to_show -%}
              {%- break -%}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PDP Suggested Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "COMPLETE THE LOOK"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 2,
      "default": 6,
      "label": "Number of products"
    }
  ],
  "presets": [
    {
      "name": "PDP Suggested Products"
    }
  ]
}
{% endschema %}

