{%- comment -%}
  ELOURA - Multi-Image Campaign Lookbook (Stacked on PC, Sliding Carousel on Mobile)
{%- endcomment -%}

<section class="pdp-lookbook-section" data-section-id="{{ section.id }}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="pdp-lookbook__header text-center">
        <h3 class="pdp-lookbook__title">{{ section.settings.heading | upcase }}</h3>
        {%- if section.settings.subheading != blank -%}
          <p class="pdp-lookbook__subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Track: Desktop grid/stacked, Mobile horizontal scroll -->
    <div class="pdp-lookbook__track js-lookbook-track">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="pdp-lookbook__slide" {{ block.shopify_attributes }}>
            <div class="pdp-lookbook__media">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 1400 }}"
                  alt="{{ block.settings.caption | default: 'Campaign image' | escape }}"
                  class="pdp-lookbook__img"
                  loading="lazy"
                  width="1400"
                  height="1750"
                >
              {%- else -%}
                {{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag: 'pdp-lookbook__img pdp-lookbook__img--placeholder' }}
              {%- endif -%}

              {%- if block.settings.caption != blank -%}
                <div class="pdp-lookbook__caption">
                  <span>{{ block.settings.caption }}</span>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Fallback 3 editorial lookbook slides -->
        {%- for i in (1..3) -%}
          <div class="pdp-lookbook__slide">
            <div class="pdp-lookbook__media">
              {{ 'lifestyle-' | append: i | placeholder_svg_tag: 'pdp-lookbook__img pdp-lookbook__img--placeholder' }}
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PDP Multi-Image Lookbook",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CAMPAIGN LOOKBOOK"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "DISCOVER THE DETAILS"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Lookbook Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Editorial Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP Multi-Image Lookbook",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}

