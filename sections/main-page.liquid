{%- comment -%}
  ELOURA - Luxury Minimalist Standard Page Template (About, Terms, Privacy Policy, Shipping)
{%- endcomment -%}

<div class="eloura-page-wrapper">
  <div class="container eloura-legal-container">
    <div class="eloura-page-header">
      <span class="eloura-page-eyebrow">INFORMATION</span>
      <h1 class="eloura-page-title">{{ page.title | upcase }}</h1>
    </div>

    <div class="eloura-article-content">
      {{ page.content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page Content",
  "settings": []
}
{% endschema %}
