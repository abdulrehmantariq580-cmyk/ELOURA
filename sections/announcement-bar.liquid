{%- if section.settings.show_announcement -%}
  <aside class="announcement-bar" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};" aria-label="Announcement">
    <div class="container announcement-bar__container">
      {%- if section.settings.is_marquee -%}
        <div class="announcement-bar__marquee">
          <div class="announcement-bar__marquee-track">
            {%- for i in (1..4) -%}
              <span class="announcement-bar__item">
                {%- if section.settings.link != blank -%}
                  <a href="{{ section.settings.link }}" class="announcement-bar__link">
                    {{ section.settings.text }}
                  </a>
                {%- else -%}
                  {{ section.settings.text }}
                {%- endif -%}
              </span>
              <span class="announcement-bar__separator">&bull;</span>
            {%- endfor -%}
          </div>
        </div>
      {%- else -%}
        <div class="announcement-bar__content">
          {%- if section.settings.link != blank -%}
            <a href="{{ section.settings.link }}" class="announcement-bar__link">
              {{ section.settings.text }}
            </a>
          {%- else -%}
            <span>{{ section.settings.text }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </aside>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "is_marquee",
      "label": "Enable running marquee ticker",
      "default": false
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "Complimentary Nationwide Express Shipping on All Orders"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %}
