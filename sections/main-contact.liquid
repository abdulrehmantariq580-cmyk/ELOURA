{%- comment -%}
  ELOURA - Luxury Minimalist Contact & Customer Care Template
{%- endcomment -%}

<div class="eloura-page-wrapper">
  <div class="container eloura-contact-container">
    <div class="eloura-page-header">
      <span class="eloura-page-eyebrow">CLIENT SERVICES</span>
      <h1 class="eloura-page-title">{{ page.title | default: 'CONTACT US' | upcase }}</h1>
      <p class="eloura-page-subtitle">Our team is available to assist you with order inquiries, product sizing, and client services.</p>
    </div>

    <div class="eloura-contact-layout">
      <!-- Contact Info Cards -->
      <div class="eloura-contact-info">
        <!-- Direct Phone & WhatsApp -->
        <div class="eloura-contact-card">
          <span class="eloura-contact-card__label">PHONE &amp; WHATSAPP</span>
          <p class="eloura-contact-card__val">+92 325 5136747</p>
          <a href="https://wa.me/923255136747" target="_blank" rel="noopener" class="eloura-contact-card__link">
            START WHATSAPP CHAT &rarr;
          </a>
        </div>

        <!-- Official Email -->
        <div class="eloura-contact-card">
          <span class="eloura-contact-card__label">EMAIL ENQUIRIES</span>
          <p class="eloura-contact-card__val">Eloura.pk1@gmail.com</p>
          <a href="mailto:Eloura.pk1@gmail.com" class="eloura-contact-card__link">
            SEND EMAIL &rarr;
          </a>
        </div>

        <!-- Social Media Channels -->
        <div class="eloura-contact-card">
          <span class="eloura-contact-card__label">OFFICIAL SOCIAL CHANNELS</span>
          <div class="eloura-contact-social-list">
            <div class="eloura-contact-social-row">
              <span class="eloura-contact-social-platform">INSTAGRAM</span>
              <a href="https://instagram.com/eloura.pk1" target="_blank" rel="noopener" class="eloura-contact-social-handle">@eloura.pk1</a>
            </div>
            <div class="eloura-contact-social-row">
              <span class="eloura-contact-social-platform">FACEBOOK</span>
              <a href="https://facebook.com/Eloura" target="_blank" rel="noopener" class="eloura-contact-social-handle">Eloura</a>
            </div>
            <div class="eloura-contact-social-row">
              <span class="eloura-contact-social-platform">TIKTOK</span>
              <a href="https://tiktok.com/@Eloura.pk1" target="_blank" rel="noopener" class="eloura-contact-social-handle">@Eloura.pk1</a>
            </div>
          </div>
        </div>

        <!-- Payment Methods / Easypaisa -->
        <div class="eloura-contact-card eloura-contact-card--payment">
          <span class="eloura-contact-card__label">DIRECT PAYMENT / EASYPAISA</span>
          <div style="display: flex; align-items: baseline; justify-content: space-between; margin-top: 0.35rem;">
            <p class="eloura-contact-card__val" style="margin: 0; font-family: monospace; letter-spacing: 0.05em; font-size: 1rem;">
              +92 325 5136747
            </p>
            <span style="font-size: 0.6875rem; font-weight: 700; background: #0A0A0A; color: #FFFFFF; padding: 2px 8px; border-radius: 2px;">
              EASYPAISA
            </span>
          </div>
          <p class="eloura-contact-card__subval" style="margin-top: 0.45rem;">
            Send payment proof on WhatsApp after transferring.
          </p>
        </div>

        <!-- Hours of Operation -->
        <div class="eloura-contact-card">
          <span class="eloura-contact-card__label">HOURS OF OPERATION</span>
          <p class="eloura-contact-card__val">Monday &ndash; Saturday: 11:00 AM &ndash; 9:00 PM (PKT)</p>
          <p class="eloura-contact-card__subval">Sunday: Closed</p>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="eloura-contact-form-wrap">
        {%- form 'contact', id: 'ContactForm', class: 'eloura-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="eloura-form-success" role="status">
              <p>Thank you for contacting ELOURA. We will reply to your inquiry within 24 hours.</p>
            </div>
          {%- elsif form.errors -%}
            <div class="eloura-form-error" role="alert">
              <p>Please check the form and correct errors before submitting.</p>
            </div>
          {%- endif -%}

          <div class="eloura-form-grid">
            <div class="eloura-form-field">
              <label for="ContactFormName" class="eloura-label">NAME *</label>
              <input
                type="text"
                id="ContactFormName"
                name="contact[name]"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                class="eloura-input"
                required
                autocomplete="name"
              >
            </div>

            <div class="eloura-form-field">
              <label for="ContactFormEmail" class="eloura-label">EMAIL *</label>
              <input
                type="email"
                id="ContactFormEmail"
                name="contact[email]"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                class="eloura-input"
                required
                autocomplete="email"
                spellcheck="false"
                autocapitalize="off"
              >
            </div>
          </div>

          <div class="eloura-form-field">
            <label for="ContactFormPhone" class="eloura-label">PHONE NUMBER</label>
            <input
              type="tel"
              id="ContactFormPhone"
              name="contact[phone]"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              class="eloura-input"
              autocomplete="tel"
            >
          </div>

          <div class="eloura-form-field">
            <label for="ContactFormMessage" class="eloura-label">MESSAGE *</label>
            <textarea
              id="ContactFormMessage"
              name="contact[body]"
              rows="6"
              class="eloura-textarea"
              required
            >{{ form.body }}</textarea>
          </div>

          <button type="submit" class="eloura-btn-solid">
            SEND MESSAGE
          </button>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact Page",
  "settings": []
}
{% endschema %}
