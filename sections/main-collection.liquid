{%- comment -%}
  ELOURA - Luxury Represent-Style Main Collection Product Grid
{%- endcomment -%}

<div class="collection-main-section" data-section-id="{{ section.id }}">
  <div class="container">
    
    <!-- Sub-header bar: Collection stats / filters -->
    <div class="collection-toolbar">
      <div class="collection-toolbar__count">
        <span>{{ collection.products_count }} styles</span>
      </div>
    </div>

    <!-- Instant Filter Search Input on /collections/all -->
    <div class="collection-filter-search" style="margin-bottom: 2rem; max-width: 480px;">
      <div style="position: relative; display: flex; align-items: center;">
        <input
          type="search"
          id="CollectionFilterInput"
          placeholder="FILTER PRODUCTS BY NAME..."
          style="width: 100%; height: 44px; padding: 0 40px 0 14px; border: 1px solid #0A0A0A; background: #FFFFFF; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; outline: none; border-radius: 1px;"
          autocomplete="off"
        >
        <span style="position: absolute; right: 14px; pointer-events: none; display: flex; align-items: center; color: #0A0A0A;">
          {% render 'icon-search' %}
        </span>
      </div>
    </div>

    <!-- Represent-Style 2-Column (Mobile) & 4-Column (PC) Grid -->
    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products.size > 0 -%}
        <div class="collection-product-grid">
          {%- for product in collection.products -%}
            <div class="collection-product-grid__item">
              {% render 'product-card', product: product %}
            </div>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div class="collection-pagination">
            {% render 'pagination', paginate: paginate %}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="collection-empty">
          <p>{{ 'sections.collection.empty' | t | default: 'No products found in this collection.' }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="collection-empty__btn">
            EXPLORE ALL PRODUCTS
          </a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}

  </div>
</div>

<script>
  // Instant search / filter for collection products
  document.addEventListener('DOMContentLoaded', function() {
    const filterInput = document.getElementById('CollectionFilterInput');
    const items = document.querySelectorAll('.collection-product-grid__item');
    if (!filterInput || !items.length) return;

    function applyFilter(query) {
      const q = query.trim().toLowerCase();
      let matchCount = 0;
      items.forEach(function(item) {
        const titleEl = item.querySelector('.product-card__name');
        const title = titleEl ? titleEl.textContent.toLowerCase() : '';
        if (!q || title.includes(q)) {
          item.style.display = '';
          matchCount++;
        } else {
          item.style.display = 'none';
        }
      });
      const countEl = document.querySelector('.collection-toolbar__count span');
      if (countEl) {
        countEl.textContent = matchCount + ' styles';
      }
    }

    filterInput.addEventListener('input', function(e) {
      applyFilter(e.target.value);
    });

    const params = new URLSearchParams(window.location.search);
    const initialQ = params.get('q');
    if (initialQ) {
      filterInput.value = initialQ;
      applyFilter(initialQ);
      filterInput.focus();
    }
  });

  // Read more / Read less toggle for collection description
  document.addEventListener('DOMContentLoaded', function() {
    const toggleBtns = document.querySelectorAll('.js-desc-toggle');
    toggleBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        const wrapper = this.closest('.js-desc-wrapper');
        const descText = wrapper ? wrapper.querySelector('.js-desc-text') : null;
        if (!descText) return;

        const isExpanded = this.getAttribute('aria-expanded') === 'true';
        if (isExpanded) {
          descText.classList.remove('is-expanded');
          this.setAttribute('aria-expanded', 'false');
          this.textContent = 'Read more';
        } else {
          descText.classList.add('is-expanded');
          this.setAttribute('aria-expanded', 'true');
          this.textContent = 'Read less';
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Collection Products",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    }
  ]
}
{% endschema %}
