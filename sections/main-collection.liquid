{%- comment -%}
  ELOURA - Luxury Represent-Style Main Collection Product Grid
{%- endcomment -%}

<div class="collection-main-section" data-section-id="{{ section.id }}">
  <div class="container">
    
    <!-- Sub-header bar: Collection stats / filters -->
    <div class="collection-toolbar">
      <div class="collection-toolbar__count">
        <span>{{ collection.products_count }} styles</span>
      </div>
    </div>

    <!-- Represent-Style 2-Column (Mobile) & 4-Column (PC) Grid -->
    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products.size > 0 -%}
        <div class="collection-product-grid">
          {%- for product in collection.products -%}
            <div class="collection-product-grid__item">
              {% render 'product-card', product: product %}
            </div>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div class="collection-pagination">
            {% render 'pagination', paginate: paginate %}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="collection-empty">
          <p>{{ 'sections.collection.empty' | t | default: 'No products found in this collection.' }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="collection-empty__btn">
            EXPLORE ALL PRODUCTS
          </a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}

  </div>
</div>

<script>
  // Read more / Read less toggle for collection description
  document.addEventListener('DOMContentLoaded', function() {
    const toggleBtns = document.querySelectorAll('.js-desc-toggle');
    toggleBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        const wrapper = this.closest('.js-desc-wrapper');
        const descText = wrapper ? wrapper.querySelector('.js-desc-text') : null;
        if (!descText) return;

        const isExpanded = this.getAttribute('aria-expanded') === 'true';
        if (isExpanded) {
          descText.classList.remove('is-expanded');
          this.setAttribute('aria-expanded', 'false');
          this.textContent = 'Read more';
        } else {
          descText.classList.add('is-expanded');
          this.setAttribute('aria-expanded', 'true');
          this.textContent = 'Read less';
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Collection Products",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    }
  ]
}
{% endschema %}
