{%- comment -%}
  ELOURA - Luxury Represent-Style Main Collection Product Grid with Live Search & Dynamic Sorting
{%- endcomment -%}

<div class="collection-main-section" data-section-id="{{ section.id }}">
  <div class="container">
    
    <!-- Controls Toolbar: Live Search + Sorting + Count -->
    <div class="collection-controls-bar">
      <!-- Live Search Filter Input -->
      <div class="collection-search-wrap">
        <div class="collection-search-field">
          <input
            type="search"
            id="CollectionFilterInput"
            placeholder="FILTER PRODUCTS BY NAME..."
            class="collection-search-input"
            autocomplete="off"
          >
          <span class="collection-search-icon">
            {% render 'icon-search' %}
          </span>
        </div>
      </div>

      <!-- Right Action Group: Sorting Selector & Count -->
      <div class="collection-sort-wrap">
        <div class="collection-sort-field">
          <label for="CollectionSortBy" class="collection-sort-label">SORT BY:</label>
          <select id="CollectionSortBy" class="collection-sort-select">
            <option value="featured">FEATURED</option>
            <option value="newest">NEWEST ARRIVALS</option>
            <option value="price-low">PRICE: LOW TO HIGH</option>
            <option value="price-high">PRICE: HIGH TO LOW</option>
            <option value="title-az">ALPHABETICAL: A-Z</option>
            <option value="title-za">ALPHABETICAL: Z-A</option>
          </select>
        </div>

        <div class="collection-toolbar__count">
          <span id="CollectionItemsCount">{{ collection.products_count }} styles</span>
        </div>
      </div>
    </div>

    <!-- Represent-Style 2-Column (Mobile) & 4-Column (PC) Grid -->
    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products.size > 0 -%}
        <div class="collection-product-grid" id="CollectionProductGrid">
          {%- for product in collection.products -%}
            <div class="collection-product-grid__item" data-price="{{ product.price }}" data-created="{{ product.created_at | date: '%s' }}" data-title="{{ product.title | escape }}">
              {% render 'product-card', product: product %}
            </div>
          {%- endfor -%}
        </div>

        <div id="CollectionNoMatch" class="collection-empty" style="display: none; padding: 4rem 1rem;">
          <p style="font-weight: 700; letter-spacing: 0.1em; color: #0A0A0A;">NO MATCHING PRODUCTS FOUND</p>
          <p style="color: #666666; font-size: 0.875rem;">Try clearing your search query or explore all products.</p>
        </div>

        {%- if paginate.pages > 1 -%}
          <div class="collection-pagination">
            {% render 'pagination', paginate: paginate %}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="collection-empty">
          <p>{{ 'sections.collection.empty' | t | default: 'No products found in this collection.' }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="collection-empty__btn">
            EXPLORE ALL PRODUCTS
          </a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}

  </div>
</div>

<script>
  // Live Instant Search & Multi-Sorting for Collection Products
  document.addEventListener('DOMContentLoaded', function() {
    const filterInput = document.getElementById('CollectionFilterInput');
    const sortSelect = document.getElementById('CollectionSortBy');
    const grid = document.getElementById('CollectionProductGrid');
    const noMatch = document.getElementById('CollectionNoMatch');
    const countEl = document.getElementById('CollectionItemsCount');

    if (!grid) return;

    let items = Array.from(grid.querySelectorAll('.collection-product-grid__item'));

    function applyFilterAndSort() {
      const q = filterInput ? filterInput.value.trim().toLowerCase() : '';
      const sortVal = sortSelect ? sortSelect.value : 'featured';

      // 1. Filter
      let visibleItems = [];
      items.forEach(function(item) {
        const titleEl = item.querySelector('.product-card__name');
        const title = titleEl ? titleEl.textContent.toLowerCase() : '';
        if (!q || title.includes(q)) {
          item.style.display = '';
          visibleItems.push(item);
        } else {
          item.style.display = 'none';
        }
      });

      // 2. Sort visible items
      if (sortVal !== 'featured') {
        visibleItems.sort(function(a, b) {
          const priceA = parseFloat(a.getAttribute('data-price')) || 0;
          const priceB = parseFloat(b.getAttribute('data-price')) || 0;
          const createdA = parseInt(a.getAttribute('data-created'), 10) || 0;
          const createdB = parseInt(b.getAttribute('data-created'), 10) || 0;
          const titleA = (a.getAttribute('data-title') || '').toLowerCase();
          const titleB = (b.getAttribute('data-title') || '').toLowerCase();

          switch(sortVal) {
            case 'newest':
              return createdB - createdA;
            case 'price-low':
              return priceA - priceB;
            case 'price-high':
              return priceB - priceA;
            case 'title-az':
              return titleA.localeCompare(titleB);
            case 'title-za':
              return titleB.localeCompare(titleA);
            default:
              return 0;
          }
        });

        // Re-append in sorted order
        visibleItems.forEach(function(item) {
          grid.appendChild(item);
        });
      }

      // 3. Update count & empty state
      if (countEl) {
        countEl.textContent = visibleItems.length + ' styles';
      }

      if (noMatch) {
        noMatch.style.display = visibleItems.length === 0 ? 'block' : 'none';
      }
    }

    if (filterInput) {
      filterInput.addEventListener('input', applyFilterAndSort);
    }

    if (sortSelect) {
      sortSelect.addEventListener('change', applyFilterAndSort);
    }

    // Check if ?q= query exists in URL
    const params = new URLSearchParams(window.location.search);
    const initialQ = params.get('q');
    if (initialQ && filterInput) {
      filterInput.value = initialQ;
      applyFilterAndSort();
      filterInput.focus();
    }
  });
</script>

{% schema %}
{
  "name": "Collection Products",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24,
      "label": "Products per page"
    }
  ]
}
{% endschema %}
