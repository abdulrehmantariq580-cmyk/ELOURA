<footer class="site-footer">
  <div class="container">
    <div class="grid grid-cols-3">
      <div class="footer-column">
        <h3>{{ shop.name }}</h3>
        <p>{{ section.settings.about_text | default: 'Welcome to our store. Discover quality products curated just for you.' }}</p>
      </div>

      <div class="footer-column">
        <h3>Quick Links</h3>
        {%- if linklists[section.settings.menu].links.size > 0 -%}
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem;">
            {%- for link in linklists[section.settings.menu].links -%}
              <li>
                <a href="{{ link.url }}">{{ link.title }}</a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="footer-column">
        <h3>Stay Connected</h3>
        <p>Subscribe to our newsletter for exclusive offers and updates.</p>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Powered by Shopify.</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About text",
      "default": "Welcome to our store. Discover quality products curated just for you."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer Menu",
      "default": "footer"
    }
  ]
}
{% endschema %}

