<footer class="eloura-footer" data-section-id="{{ section.id }}">
  <div class="eloura-footer__top-border"></div>
  
  <div class="eloura-footer__main container">
    <div class="eloura-footer__grid">
      
      <!-- Newsletter / Loyalty Column -->
      <div class="eloura-footer__col eloura-footer__col--loyalty">
        <h4 class="eloura-footer__heading">{{ section.settings.loyalty_heading | default: 'Join Eloura Prestige Loyalty' }}</h4>
        <p class="eloura-footer__subtext">{{ section.settings.loyalty_subtext | default: 'Unlock 10% Off Your First Purchase Plus More Rewards And Benefits' }}</p>
        
        {%- if section.settings.signup_link != blank -%}
          <a href="{{ section.settings.signup_link }}" class="eloura-footer__signup-btn">
            &rarr; {{ section.settings.signup_label | default: 'SIGN UP' }}
          </a>
        {%- else -%}
          {%- form 'customer', class: 'eloura-footer__newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="eloura-footer__input-wrapper">
              <input
                type="email"
                name="contact[email]"
                class="eloura-footer__input"
                value="{{ form.email }}"
                placeholder="Enter your email"
                aria-label="Enter your email"
                required
              >
              <button type="submit" class="eloura-footer__submit-btn" aria-label="Sign up">
                &rarr;
              </button>
            </div>
            {%- if form.posted_successfully? -%}
              <p class="eloura-footer__form-success">Thank you for joining.</p>
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}
      </div>

      <!-- Navigation Menus (Desktop Grid & Mobile Accordion) -->
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div class="eloura-footer__col eloura-footer__col--menu" {{ block.shopify_attributes }}>
              <details class="eloura-footer__accordion" open>
                <summary class="eloura-footer__summary">
                  <span class="eloura-footer__heading">{{ block.settings.title | default: linklists[block.settings.menu].title }}</span>
                  <span class="eloura-footer__accordion-icon" aria-hidden="true">+</span>
                </summary>
                {%- if linklists[block.settings.menu].links.size > 0 -%}
                  <ul class="eloura-footer__nav-list">
                    {%- for link in linklists[block.settings.menu].links -%}
                      <li class="eloura-footer__nav-item">
                        <a href="{{ link.url }}" class="eloura-footer__nav-link">
                          {%- if link.title contains 'Live Chat' or link.title contains 'live chat' -%}
                            <span class="eloura-footer__live-dot"></span>
                          {%- endif -%}
                          {{ link.title }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </details>
            </div>

          {%- when 'apps' -%}
            <div class="eloura-footer__col eloura-footer__col--apps" {{ block.shopify_attributes }}>
              <details class="eloura-footer__accordion" open>
                <summary class="eloura-footer__summary">
                  <span class="eloura-footer__heading">{{ block.settings.title | default: 'Download App' }}</span>
                  <span class="eloura-footer__accordion-icon" aria-hidden="true">+</span>
                </summary>
                <ul class="eloura-footer__nav-list">
                  {%- if block.settings.ios_link != blank -%}
                    <li class="eloura-footer__nav-item">
                      <a href="{{ block.settings.ios_link }}" class="eloura-footer__nav-link eloura-footer__nav-link--icon" target="_blank" rel="noopener">
                        <svg class="eloura-footer__icon" viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 1.01-2.85-.9.04-1.98.6-2.63 1.35-.57.65-1.07 1.72-.94 2.74 1 .08 2-.51 2.56-1.24z"/>
                        </svg>
                        <span>iOS</span>
                      </a>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.android_link != blank -%}
                    <li class="eloura-footer__nav-item">
                      <a href="{{ block.settings.android_link }}" class="eloura-footer__nav-link eloura-footer__nav-link--icon" target="_blank" rel="noopener">
                        <svg class="eloura-footer__icon" viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                          <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.551 0 .9993.4482.9993.9993.0001.5511-.4483.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993 0 .5511-.4482.9997-.9993.9997m11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.416.416 0 00-.5676.1521l-2.0223 3.503C15.5896 8.3585 13.8559 8 12 8s-3.5896.3585-5.1368.9497L4.8409 5.4467a.4161.4161 0 00-.5677-.1521.4157.4157 0 00-.1521.5676l1.9973 3.4592C2.6889 11.1867.3432 14.6589 0 18.761h24c-.3432-4.1021-2.6889-7.5743-6.1185-9.4396"/>
                        </svg>
                        <span>Android</span>
                      </a>
                    </li>
                  {%- endif -%}
                </ul>
              </details>
            </div>
        {%- endcase -%}
      {%- endfor -%}

      <!-- Country / Localization Column -->
      <div class="eloura-footer__col eloura-footer__col--country">
        <h4 class="eloura-footer__heading">{{ section.settings.country_heading | default: 'Country' }}</h4>
        
        <div class="eloura-footer__localization">
          <button type="button" class="eloura-footer__country-selector" aria-label="Select country and currency">
            <span class="eloura-footer__country-flag">🇵🇰</span>
            <span class="eloura-footer__country-text">{{ section.settings.country_display | default: 'PK / PKR ₨ | English' }}</span>
            <svg class="eloura-footer__chevron" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- Bottom Bar: Copyright & Policies -->
  <div class="eloura-footer__bottom container">
    <div class="eloura-footer__copyright">
      &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text | default: 'ELOURA CLOTHING LIMITED' }}
    </div>

    {%- if linklists[section.settings.bottom_menu].links.size > 0 -%}
      <ul class="eloura-footer__policy-list">
        {%- for link in linklists[section.settings.bottom_menu].links -%}
          <li class="eloura-footer__policy-item">
            <a href="{{ link.url }}" class="eloura-footer__policy-link">{{ link.title }}</a>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <ul class="eloura-footer__policy-list">
        <li class="eloura-footer__policy-item"><a href="/policies/terms-of-service" class="eloura-footer__policy-link">Terms &amp; Conditions</a></li>
        <li class="eloura-footer__policy-item"><a href="/policies/privacy-policy" class="eloura-footer__policy-link">Privacy Policy</a></li>
        <li class="eloura-footer__policy-item"><a href="/policies/shipping-policy" class="eloura-footer__policy-link">Shipping &amp; Returns Policy</a></li>
        <li class="eloura-footer__policy-item"><a href="/policies/refund-policy" class="eloura-footer__policy-link">Cookie Policy</a></li>
        <li class="eloura-footer__policy-item"><a href="#" class="eloura-footer__policy-link">Cookies Preferences</a></li>
      </ul>
    {%- endif -%}
  </div>
</footer>

<script>
  // Mobile accordion toggle for footer menus
  document.addEventListener('DOMContentLoaded', function() {
    function handleFooterAccordion() {
      const isMobile = window.innerWidth <= 768;
      const accordions = document.querySelectorAll('.eloura-footer__accordion');
      
      accordions.forEach(function(acc) {
        if (!isMobile) {
          acc.setAttribute('open', '');
        } else {
          // On mobile start collapsed
          if (!acc.dataset.userInteracted) {
            acc.removeAttribute('open');
          }
        }
      });
    }

    document.querySelectorAll('.eloura-footer__summary').forEach(function(summary) {
      summary.addEventListener('click', function() {
        const details = this.closest('details');
        if (details) {
          details.dataset.userInteracted = 'true';
        }
      });
    });

    handleFooterAccordion();
    window.addEventListener('resize', handleFooterAccordion);
  });
</script>

{% schema %}
{
  "name": "Luxury Footer",
  "settings": [
    {
      "type": "header",
      "content": "Loyalty / Newsletter"
    },
    {
      "type": "text",
      "id": "loyalty_heading",
      "label": "Heading",
      "default": "Join Eloura Prestige Loyalty"
    },
    {
      "type": "textarea",
      "id": "loyalty_subtext",
      "label": "Subtext",
      "default": "Unlock 10% Off Your First Purchase Plus More Rewards And Benefits"
    },
    {
      "type": "text",
      "id": "signup_label",
      "label": "Sign Up Button Label",
      "default": "SIGN UP"
    },
    {
      "type": "url",
      "id": "signup_link",
      "label": "Sign Up Button Link (Leave blank for email input form)"
    },
    {
      "type": "header",
      "content": "Country Selector"
    },
    {
      "type": "text",
      "id": "country_heading",
      "label": "Country Heading",
      "default": "Country"
    },
    {
      "type": "text",
      "id": "country_display",
      "label": "Country & Currency Text",
      "default": "PK / PKR ₨ | English"
    },
    {
      "type": "header",
      "content": "Bottom Bar"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "ELOURA CLOTHING LIMITED"
    },
    {
      "type": "link_list",
      "id": "bottom_menu",
      "label": "Bottom Policies Menu"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Column Title (Optional)"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Select Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "apps",
      "name": "Download App Links",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Download App"
        },
        {
          "type": "url",
          "id": "ios_link",
          "label": "iOS App Store Link"
        },
        {
          "type": "url",
          "id": "android_link",
          "label": "Android Google Play Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Footer",
      "blocks": [
        {
          "type": "menu",
          "settings": {
            "title": "Client Services"
          }
        },
        {
          "type": "menu",
          "settings": {
            "title": "Company"
          }
        },
        {
          "type": "menu",
          "settings": {
            "title": "Social"
          }
        },
        {
          "type": "apps"
        }
      ]
    }
  ]
}
{% endschema %}
