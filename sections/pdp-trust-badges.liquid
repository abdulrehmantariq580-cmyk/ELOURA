{%- comment -%}
  ELOURA - Universal Luxury Streetwear Trust Badges
{%- endcomment -%}

<section class="pdp-trust-badges-section" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="pdp-trust-badges__grid">
      
      <!-- Badge 1: Shipping -->
      <div class="pdp-trust-badge">
        <div class="pdp-trust-badge__icon">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        </div>
        <div class="pdp-trust-badge__text">
          <h4 class="pdp-trust-badge__title">{{ section.settings.badge1_title | default: 'EXPRESS DELIVERY' }}</h4>
          <p class="pdp-trust-badge__desc">{{ section.settings.badge1_desc | default: 'Dispatched in 24-48 hours with door-to-door tracking' }}</p>
        </div>
      </div>

      <!-- Badge 2: Premium Quality -->
      <div class="pdp-trust-badge">
        <div class="pdp-trust-badge__icon">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
          </svg>
        </div>
        <div class="pdp-trust-badge__text">
          <h4 class="pdp-trust-badge__title">{{ section.settings.badge2_title | default: 'BESPOKE QUALITY' }}</h4>
          <p class="pdp-trust-badge__desc">{{ section.settings.badge2_desc | default: 'Heavyweight custom-milled fabrics built to endure' }}</p>
        </div>
      </div>

      <!-- Badge 3: Returns & Exchanges -->
      <div class="pdp-trust-badge">
        <div class="pdp-trust-badge__icon">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6">
            <polyline points="1 4 1 10 7 10"></polyline>
            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
          </svg>
        </div>
        <div class="pdp-trust-badge__text">
          <h4 class="pdp-trust-badge__title">{{ section.settings.badge3_title | default: 'EASY EXCHANGES' }}</h4>
          <p class="pdp-trust-badge__desc">{{ section.settings.badge3_desc | default: '7-day hassle-free size replacement & exchange' }}</p>
        </div>
      </div>

      <!-- Badge 4: Secure Checkout -->
      <div class="pdp-trust-badge">
        <div class="pdp-trust-badge__icon">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <div class="pdp-trust-badge__text">
          <h4 class="pdp-trust-badge__title">{{ section.settings.badge4_title | default: 'SECURE PAYMENTS' }}</h4>
          <p class="pdp-trust-badge__desc">{{ section.settings.badge4_desc | default: 'Cash on Delivery & Encrypted 256-bit Online Checkout' }}</p>
        </div>
      </div>

    </div>
  </div>
</section>

