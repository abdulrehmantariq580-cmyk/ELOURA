<section class="category-grid-section" data-section-id="{{ section.id }}">
  <div class="category-grid-container">
    {%- if section.settings.section_heading != blank -%}
      <div class="category-grid-header container">
        <h2 class="category-grid-title">{{ section.settings.section_heading | upcase }}</h2>
      </div>
    {%- endif -%}

    <div class="category-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = collections[block.settings.collection]
          assign category_title = block.settings.title
          if category_title == blank and collection != blank
            assign category_title = collection.title
          endif
          if category_title == blank
            assign category_title = 'CATEGORY'
          endif

          assign category_link = block.settings.link
          if category_link == blank and collection != blank
            assign category_link = collection.url
          endif
          if category_link == blank
            assign category_link = routes.all_products_collection_url
          endif
        -%}

        <div class="category-card" {{ block.shopify_attributes }}>
          <a href="{{ category_link }}" class="category-card__link">
            <div class="category-card__media">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 1200 }}"
                  alt="{{ category_title | escape }}"
                  class="category-card__image"
                  loading="lazy"
                  width="1200"
                  height="1400"
                >
              {%- elsif collection.image != blank -%}
                <img
                  src="{{ collection.image | image_url: width: 1200 }}"
                  alt="{{ category_title | escape }}"
                  class="category-card__image"
                  loading="lazy"
                  width="1200"
                  height="1400"
                >
              {%- elsif collection.products.first.featured_image != blank -%}
                <img
                  src="{{ collection.products.first.featured_image | image_url: width: 1200 }}"
                  alt="{{ category_title | escape }}"
                  class="category-card__image"
                  loading="lazy"
                  width="1200"
                  height="1400"
                >
              {%- else -%}
                {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'category-card__image category-card__image--placeholder' }}
              {%- endif -%}
            </div>

            <div class="category-card__info">
              <h3 class="category-card__title">{{ category_title | upcase }}</h3>
            </div>
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial Category Grid",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading (Optional)"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "info": "Leave blank to automatically use the selected Collection's title."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Link Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Category Image",
          "info": "Upload custom editorial shot. If empty, uses collection image."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial Category Grid",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "JACKETS"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "HOODIES"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "SWEATSHIRTS"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "PANTS & CARGOS"
          }
        }
      ]
    }
  ]
}
{% endschema %}
