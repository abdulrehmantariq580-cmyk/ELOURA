{%- comment -%}
  ELOURA - Luxury Represent-Style Search Page with Instant Live Search
{%- endcomment -%}

<div class="eloura-search-page container" data-section-id="{{ section.id }}">
  <!-- Search Header Box -->
  <div class="eloura-search-header">
    <span class="eloura-search-eyebrow">EXPLORE CATALOG</span>
    <h1 class="eloura-search-title">SEARCH</h1>

    <!-- Minimalist Streetwear Live Search Input -->
    <div class="eloura-search-input-wrap">
      <input
        type="search"
        id="LiveSearchInput"
        placeholder="TYPE TO SEARCH HOODIES, JACKETS, PANTS..."
        class="eloura-search-input"
        autocomplete="off"
        autofocus
      >
      <span class="eloura-search-submit" style="pointer-events: none;">
        {% render 'icon-search' %}
      </span>
    </div>

    <p class="eloura-search-count" id="LiveSearchCount">
      SHOWING ALL PRODUCTS
    </p>
  </div>

  <!-- Search Results / Catalog Grid (Shows All Products initially and filters instantly) -->
  <div class="collection-product-grid" id="LiveSearchGrid">
    {%- paginate collections.all.products by 48 -%}
      {%- for product in collections.all.products -%}
        <div class="collection-product-grid__item live-search-item" data-title="{{ product.title | escape }}">
          {% render 'product-card', product: product %}
        </div>
      {%- endfor -%}
    {%- endpaginate -%}
  </div>

  <!-- No match empty state -->
  <div id="LiveSearchEmpty" class="eloura-search-empty" style="display: none;">
    <p class="eloura-search-empty__title">NO PRODUCTS FOUND</p>
    <p class="eloura-search-empty__text">We couldn't find any products matching your search query. Try typing something else or check your spelling.</p>
    <button type="button" id="LiveSearchResetBtn" class="eloura-search-empty__btn" style="cursor: pointer; border: none;">
      CLEAR SEARCH
    </button>
  </div>
</div>

<script>
  // Instant Live Search across Catalog
  document.addEventListener('DOMContentLoaded', function() {
    const input = document.getElementById('LiveSearchInput');
    const grid = document.getElementById('LiveSearchGrid');
    const emptyState = document.getElementById('LiveSearchEmpty');
    const countEl = document.getElementById('LiveSearchCount');
    const resetBtn = document.getElementById('LiveSearchResetBtn');

    if (!input || !grid) return;

    const items = Array.from(grid.querySelectorAll('.live-search-item'));

    function performLiveSearch(term) {
      const q = term.trim().toLowerCase();
      let matchCount = 0;

      items.forEach(function(item) {
        const title = (item.getAttribute('data-title') || '').toLowerCase();
        if (!q || title.includes(q)) {
          item.style.display = '';
          matchCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (q) {
        countEl.textContent = matchCount + (matchCount === 1 ? ' RESULT' : ' RESULTS') + ' FOR "' + term.toUpperCase() + '"';
      } else {
        countEl.textContent = 'SHOWING ALL ' + items.length + ' PRODUCTS';
      }

      emptyState.style.display = matchCount === 0 ? 'block' : 'none';
      grid.style.display = matchCount === 0 ? 'none' : 'grid';
    }

    input.addEventListener('input', function(e) {
      performLiveSearch(e.target.value);
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', function() {
        input.value = '';
        performLiveSearch('');
        input.focus();
      });
    }

    // Check URL params (?q=...)
    const params = new URLSearchParams(window.location.search);
    const initialQuery = params.get('q');
    if (initialQuery) {
      input.value = initialQuery;
      performLiveSearch(initialQuery);
    } else {
      performLiveSearch('');
    }
  });
</script>

{% schema %}
{
  "name": "Live Search",
  "settings": []
}
{% endschema %}
