<article class="article-page container" style="padding: 3rem 0; max-width: 800px;">
  <header style="margin-bottom: 2rem; text-align: center;">
    <h1>{{ article.title }}</h1>
    <p style="color: var(--color-text-muted);">{{ article.published_at | date: '%B %d, %Y' }} &bull; {{ article.author }}</p>
  </header>

  {%- if article.image -%}
    <div style="margin-bottom: 2rem;">
      <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.title }}" style="width: 100%; border-radius: var(--border-radius);">
    </div>
  {%- endif -%}

  <div class="article-content" style="line-height: 1.8;">
    {{ article.content }}
  </div>
</article>

{% schema %}
{
  "name": "Blog Post",
  "settings": []
}
{% endschema %}
