{%- comment -%}
  ELOURA - Luxury Floating WhatsApp Button (Represent Clo Streetwear Aesthetic)
  Features:
  - Fixed at bottom-right of viewport across Home, Catalog & PDP
  - Sleek luxury monochrome & emerald-accented badge styling
  - Dynamic product context message when on product page
  - Interactive tooltip badge on hover
{%- endcomment -%}

{%- liquid
  assign wa_num = settings.whatsapp_number | default: '923000000000' | remove: '+' | remove: ' ' | remove: '-'
  
  if template.name == 'product'
    assign default_text = 'Hi ELOURA, I want to inquire about ' | append: product.title | append: ' (' | append: canonical_url | append: ')'
  elsif template.name == 'collection'
    assign default_text = 'Hi ELOURA, I want to inquire about the ' | append: collection.title | append: ' collection.'
  else
    assign default_text = settings.whatsapp_default_message | default: 'Hi ELOURA, I have an inquiry about your products.'
  endif

  assign encoded_msg = default_text | url_encode
-%}

<div class="eloura-floating-wa" id="ElouraFloatingWhatsApp">
  <a
    href="https://wa.me/{{ wa_num }}?text={{ encoded_msg }}"
    target="_blank"
    rel="noopener noreferrer"
    class="eloura-floating-wa__btn"
    aria-label="Chat with ELOURA on WhatsApp"
  >
    <!-- Tooltip Label (Expands on hover) -->
    <span class="eloura-floating-wa__tooltip">
      CHAT WITH US
    </span>

    <!-- WhatsApp Luxury Icon Badge -->
    <div class="eloura-floating-wa__icon-wrap">
      <svg class="eloura-floating-wa__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
      </svg>
      <!-- Online Pulse Indicator -->
      <span class="eloura-floating-wa__status-dot"></span>
    </div>
  </a>
</div>
