{%- comment -%}
  ELOURA - Luxury Represent Clo Style Product Card
  Accepts:
  - product: {Object} Product Liquid object
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  
  # Secondary hover image
  assign hover_image = nil
  if product.images.size > 1
    assign hover_image = product.images[1]
  endif
-%}

<div class="product-card" data-product-id="{{ product.id }}" data-price="{{ product.price }}" data-created-at="{{ product.created_at | date: '%s' }}" data-title="{{ product.title | escape }}">
  <!-- Full-Cover Media Box: Edge-to-Edge Image Fill -->
  <div class="product-card__media-box">
    <a href="{{ product.url }}" class="product-card__link" tabindex="-1">
      {%- if product.featured_image != blank -%}
        <img
          src="{{ product.featured_image | image_url: width: 900 }}"
          alt="{{ product.title | escape }}"
          class="product-card__img product-card__img--primary"
          loading="lazy"
          width="900"
          height="1125"
        >
        {%- if hover_image != nil -%}
          <img
            src="{{ hover_image | image_url: width: 900 }}"
            alt="{{ product.title | escape }}"
            class="product-card__img product-card__img--hover"
            loading="lazy"
            width="900"
            height="1125"
          >
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__img product-card__img--placeholder' }}
      {%- endif -%}
    </a>

    <!-- White Square Button with Black Plus/Cart Icon on Bottom-Right -->
    <button
      type="button"
      class="product-card__square-btn js-quick-add-btn"
      aria-label="Add {{ product.title | escape }} to Bag"
      data-variant-id="{{ current_variant.id }}"
      {% unless product.available %}disabled{% endunless %}
    >
      <!-- Premium Cart + Plus Combined Icon -->
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <path d="M16 10a4 4 0 0 1-8 0"/>
        <line x1="12" y1="13" x2="12" y2="17"/>
        <line x1="10" y1="15" x2="14" y2="15"/>
      </svg>
    </button>
  </div>

  <!-- Product Details Below Card -->
  <div class="product-card__meta">
    <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem; margin-bottom: 0.75rem;">
      <h3 class="product-card__name" style="margin: 0; font-size: 0.875rem; font-weight: 700;">
        <a href="{{ product.url }}">{{ product.title }}</a>
      </h3>

      <div class="product-card__pricing" style="white-space: nowrap;">
        <span class="product-card__price" style="font-weight: 600; font-size: 0.875rem;">{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="product-card__compare-price" style="text-decoration: line-through; color: #888888; font-size: 0.75rem; margin-left: 0.35rem;">
            {{ product.compare_at_price | money }}
          </span>
        {%- endif -%}
      </div>
    </div>

    <!-- Quick View Clean Outline Button -->
    <a
      href="{{ product.url }}"
      class="product-card__quick-view-btn"
      style="display: flex; align-items: center; justify-content: center; width: 100%; height: 40px; background-color: transparent; color: #0A0A0A; border: 1px solid #0A0A0A; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none; border-radius: 1px; transition: background-color 0.2s ease, color 0.2s ease;"
    >
      QUICK VIEW
    </a>
  </div>
</div>
