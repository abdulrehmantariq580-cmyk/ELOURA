{%- comment -%}
  ELOURA - Represent Clo Style Product Card
  Accepts:
  - product: {Object} Product Liquid object
{%- endcomment -%}

<div class="product-card" data-product-id="{{ product.id }}">
  <div class="product-card__media-box">
    <!-- Top-Right Wishlist / Bookmark Icon -->
    <button type="button" class="product-card__bookmark-btn js-wishlist-toggle" aria-label="Save to Wishlist">
      {% render 'icon-bookmark' %}
    </button>

    <!-- Product Cutout Image -->
    <a href="{{ product.url }}" class="product-card__link" tabindex="-1">
      {%- if product.featured_image != blank -%}
        <img
          src="{{ product.featured_image | image_url: width: 700 }}"
          alt="{{ product.title | escape }}"
          class="product-card__img"
          loading="lazy"
          width="700"
          height="700"
        >
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__img product-card__img--placeholder' }}
      {%- endif -%}
    </a>

    <!-- Bottom-Right Quick-Add (+) Button -->
    <button
      type="button"
      class="product-card__quick-add-btn js-quick-add-btn"
      aria-label="Quick Add {{ product.title | escape }}"
      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      {% unless product.available %}disabled{% endunless %}
    >
      {% render 'icon-plus' %}
    </button>
  </div>

  <!-- Product Details Below Card -->
  <div class="product-card__meta">
    <h3 class="product-card__name">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    {%- assign color_option = product.options_by_name['Color'] or product.options_by_name['Colour'] -%}
    {%- if color_option -%}
      <p class="product-card__color-title">
        {{ product.selected_or_first_available_variant.option1 | default: color_option.values.first }}
      </p>
      <div class="product-card__swatch-row">
        <span class="product-card__swatch-dot" style="background-color: #111111;"></span>
        <span class="product-card__colour-count">{{ color_option.values.size }} Colour{% if color_option.values.size > 1 %}s{% endif %}</span>
      </div>
    {%- else -%}
      <p class="product-card__color-title">Jet Black</p>
      <div class="product-card__swatch-row">
        <span class="product-card__swatch-dot" style="background-color: #111111;"></span>
        <span class="product-card__colour-count">1 Colour</span>
      </div>
    {%- endif -%}

    <div class="product-card__pricing">
      <span class="product-card__price">{{ product.price | money }}</span>
      {%- if product.compare_at_price > product.price -%}
        <span class="product-card__compare-price">{{ product.compare_at_price | money }}</span>
      {%- endif -%}
    </div>
  </div>
</div>
