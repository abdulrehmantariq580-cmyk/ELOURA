{%- comment -%}
  ELOURA - Luxury Represent Clo Style Product Card
  Accepts:
  - product: {Object} Product Liquid object
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  
  # Secondary hover image
  assign hover_image = nil
  if product.images.size > 1
    assign hover_image = product.images[1]
  endif
-%}

<div class="product-card" data-product-id="{{ product.id }}">
  <div class="product-card__media-box">
    <!-- Minimalist Streetwear Fit Tag -->
    <div class="product-card__tag">
      <span>OVERSIZED FIT</span>
    </div>

    <!-- Top-Right Wishlist / Bookmark Icon -->
    <button type="button" class="product-card__bookmark-btn js-wishlist-toggle" aria-label="Save to Wishlist">
      {% render 'icon-bookmark' %}
    </button>

    <!-- Product Image with Full-Cover Center & Secondary Image on Hover -->
    <a href="{{ product.url }}" class="product-card__link" tabindex="-1">
      {%- if product.featured_image != blank -%}
        <img
          src="{{ product.featured_image | image_url: width: 900 }}"
          alt="{{ product.title | escape }}"
          class="product-card__img product-card__img--primary"
          loading="lazy"
          width="900"
          height="1050"
        >
        {%- if hover_image != nil -%}
          <img
            src="{{ hover_image | image_url: width: 900 }}"
            alt="{{ product.title | escape }}"
            class="product-card__img product-card__img--hover"
            loading="lazy"
            width="900"
            height="1050"
          >
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__img product-card__img--placeholder' }}
      {%- endif -%}
    </a>

    <!-- Bottom-Right Quick-Add (+) Button -->
    <button
      type="button"
      class="product-card__quick-add-btn js-quick-add-btn"
      aria-label="Quick Add {{ product.title | escape }}"
      data-variant-id="{{ current_variant.id }}"
      {% unless product.available %}disabled{% endunless %}
    >
      {% render 'icon-plus' %}
    </button>
  </div>

  <!-- Product Details Below Card: Clean Title & Price -->
  <div class="product-card__meta">
    <h3 class="product-card__name">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    <div class="product-card__pricing">
      <span class="product-card__price">{{ product.price | money }}</span>
      {%- if product.compare_at_price > product.price -%}
        <span class="product-card__compare-price">{{ product.compare_at_price | money }}</span>
      {%- endif -%}
    </div>
  </div>
</div>
